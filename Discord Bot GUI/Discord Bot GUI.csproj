<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>ResourceFiles\Kim_Synthji.ico</ApplicationIcon>
		<RootNamespace>Discord_Bot</RootNamespace>
		<StartupObject>Discord_Bot.App</StartupObject>
		<AssemblyName>Discord Bot</AssemblyName>
		<FileVersion>1.2.0</FileVersion>
		<AssemblyVersion>3.2.0</AssemblyVersion>
		<Version>3.2.0</Version>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<NeutralLanguage>en</NeutralLanguage>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.10.3" />
		<PackageReference Include="Mapster" Version="10.0.14" />
		<PackageReference Include="Discord.Net" Version="3.20.2" />
		<PackageReference Include="Google.Apis.YouTube.v3" Version="1.78.0.4325" />
		<PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.1.0" />
		<PackageReference Include="PuppeteerSharp" Version="25.17.1" />
		<PackageReference Include="RestSharp" Version="114.1.0" />
		<PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
		<PackageReference Include="TwitchLib.Api" Version="3.11.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Core\Configuration\config.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
		<Content Include="External Files\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
		</Content>
		<Content Remove="$(NuGetPackageRoot)\microsoft.codeanalysis.workspaces.msbuild\**\**" Visible="false" CopyToOutputDirectory="Never" />
		<ProjectReference Include="..\DatabaseORM\DatabaseORM.csproj" />
		<ProjectReference Include="..\LastFmApi\LastFmApi.csproj" />
		<Resource Include="ResourceFiles\Kim_Synthji.ico" />
		<Compile Update="Properties\Resource.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resource.resx</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Properties\Resource.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resource.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>