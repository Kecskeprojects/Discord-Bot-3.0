# Root EditorConfig for the whole repository. Analyzer level and build enforcement are set in Directory.Build.props.
# Visual Studio and `dotnet build` both read this file, so a warning here shows up in both.
# Severity changes that silence a rule must say why (same rule as Properties/GlobalSuppressions.cs).
root = true

# CRLF everywhere, matching .gitattributes (eol=crlf) and what Visual Studio, EF scaffolding and SSDT write.
# dotnet format then rewrites every LF line (ENDOFLINE) instead of only the ones next to comments (IDE0055),
# and Prettier in VS Code writes CRLF too. Git stores LF, so a file some tool saves with LF shows as modified
# with an empty diff until it is converted back (unix2dos).
[*]
end_of_line = crlf
# The UTF-8 BOM follows the tool that creates each kind of file, so a file that tool writes again matches without an extra step.
# No BOM by default (Markdown, JSON, txt, the git and editor config files), as VS Code, git tooling and File.WriteAllText write them.
charset = utf-8

# A BOM for what Visual Studio, dotnet new and SSDT create. dotnet format enforces it for C# (CHARSET).
# The EF-scaffolded MainDbContext.cs and models go back to no BOM in their own sections below.
[*.{cs,csproj,sln,sqlproj,xaml,resx,sql,props,refactorlog}]
charset = utf-8-bom

[*.cs]
indent_style = space
indent_size = 4

#### Formatting: only the options that differ from the .NET defaults, matching the owner's Visual Studio settings ####
csharp_space_after_cast = true
csharp_indent_case_contents_when_block = false

#### Code style preferences that differ from the .NET defaults ####
csharp_style_namespace_declarations = file_scoped
csharp_prefer_simple_using_statement = false
csharp_style_expression_bodied_lambdas = when_on_single_line
csharp_style_expression_bodied_local_functions = when_on_single_line
# An if/else that only assigns or returns may stay an if/else (IDE0045 / IDE0046 off). As warnings they made the build
# reject it, and Code Cleanup turned complex if/else blocks into ?: chains. Ternaries are for simple value choices.
dotnet_style_prefer_conditional_expression_over_assignment = false
dotnet_style_prefer_conditional_expression_over_return = false

#### Code style (IDE) rules: everything Visual Studio suggests is a build warning ####
dotnet_analyzer_diagnostic.category-Style.severity = warning
# Code quality IDE rules too: unused or unread private members, unnecessary suppressions, ...
dotnet_analyzer_diagnostic.category-CodeQuality.severity = warning

# Populate switch: a switch doesn't need a case for every enum value when the default branch covers the rest.
dotnet_diagnostic.IDE0010.severity = suggestion
dotnet_diagnostic.IDE0072.severity = suggestion

# Collection expression for fluent calls (IDE0305) off in every project, the tests included: a LINQ chain ends in .ToList() /
# .ToArray() / .ToHashSet(), which reads better than a spread around the whole chain ([.. items.Where(...)]). As a warning
# it made the build reject the .ToList() form. A spread is still fine for a plain conversion ([.. someArray]).
dotnet_diagnostic.IDE0305.severity = none

#### Naming (IDE1006) ####
# Private fields are camelCase without a prefix, static and readonly ones included.
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_rule.private_fields_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case

# Private constants stay PascalCase, like the public ones in Constant.cs (the more specific rule wins).
dotnet_naming_rule.private_constants_pascal_case.symbols = private_constants
dotnet_naming_rule.private_constants_pascal_case.style = pascal_case
dotnet_naming_rule.private_constants_pascal_case.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

#### Code quality (CA) rules: AnalysisLevel latest-recommended, with these additions and exceptions ####

# Added on top of latest-recommended: CA2000 (dispose objects before losing scope), CA1063 (implement IDisposable
# correctly), CA1508 (dead conditional code; kept after a trial, false positives are suppressed with a reason),
# CA1052 (classes with only static members are static), CA1851 (an IEnumerable enumerated more than once) and
# CA2234 (pass Uri, not string).
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA1063.severity = warning
dotnet_diagnostic.CA1508.severity = warning
dotnet_diagnostic.CA1052.severity = warning
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA2234.severity = warning

# CA1304 / CA1311 (ToLower/ToUpper without a culture): lowercasing only differs from the invariant culture under Turkish,
# Azerbaijani and Lithuanian cultures, which the bot's machines don't use (dev PC: hu-HU). Most calls are inside EF
# queries, which SQL Server translates to LOWER() anyway.
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1311.severity = none

# CA1305 (IFormatProvider): integer ToString/Parse is the same in every culture for the values used here (Discord IDs,
# counts). The rule stays on for double, DateTime and string.Format, where hu-HU really differs ("3,5", "2026. 11. 16.").
dotnet_code_quality.CA1305.excluded_symbol_names = M:System.UInt64.ToString|M:System.UInt64.Parse(System.String)|M:System.Int64.ToString|M:System.Int32.ToString|M:System.Int32.Parse(System.String)|M:System.Byte.Parse(System.String)

# CA1051 (visible instance fields): single-assembly app with no outside consumers. The protected fields on the base
# classes (BaseCommand, BaseFeature, BaseService, ...) and Config's public fields are not a library API.
dotnet_diagnostic.CA1051.severity = none

# CA1707 (underscores in names): the root namespace is Discord_Bot, and Config's property names mirror config.json keys.
dotnet_diagnostic.CA1707.severity = none

# CA1711 (type name ends in "Enum"): project convention for every enum (ChannelTypeEnum, DbProcessResultEnum, ...).
dotnet_diagnostic.CA1711.severity = none

# CA1716 (names that are keywords in other .NET languages, e.g. Global, Date): only matters for VB consumers of a library.
dotnet_diagnostic.CA1716.severity = none

# Generated code: nullable-oblivious and skipped by the analyzers. The JSON models are generated from API responses, and
# MainDbContext is scaffolded.
[Discord Bot GUI/Services/Models/**.cs]
generated_code = true

[DatabaseORM/Context/MainDbContext.cs]
generated_code = true
# EF Core 11 scaffolds without a BOM, so a re-scaffold matches without an extra step
charset = utf-8

[LastFmApi/Models/**.cs]
generated_code = true

# The scaffolded EF models are not marked as generated code: with nullable on, the scaffold writes `?` for nullable columns
# and optional navigations instead of .IsRequired(), so EF and the compiler need those annotations to count (in generated
# code they are off, and a `?` there is error CS8669). Only the style rules a new scaffold would undo are turned off.
[DatabaseORM/Model/**.cs]
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0028.severity = none
# EF Core 11 scaffolds without a BOM, so a re-scaffold matches without an extra step
charset = utf-8

# The tests. IDE0058 (unused expression value) is off: NSubstitute's setup calls (x.Returns(...), x.When(...)) return a
# value that is only there for chaining, and a `_ =` in front of every setup line would make the tests harder to read.
[Discord Bot Tests/**.cs]
dotnet_diagnostic.IDE0058.severity = none
