<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- The bot is a WPF app, so the tests load the Windows Desktop framework too -->
		<UseWPF>true</UseWPF>
		<RootNamespace>Discord_Bot.Tests</RootNamespace>
		<AssemblyName>Discord Bot Tests</AssemblyName>
		<!-- xUnit v3 test projects are executables -->
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageReference Include="NSubstitute" Version="6.2.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Discord Bot GUI\Discord Bot GUI.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- Used by nearly every test file -->
		<Using Include="Xunit" />
		<Using Include="NSubstitute" />
	</ItemGroup>
</Project>
